# Required for a live run. Tests mock the LLM and do not need a key.
OPENAI_API_KEY=

# Optional. Defaults to https://api.openai.com/v1
# Use this for Azure, Groq, Ollama, OpenRouter, or any OpenAI-compatible server.
OPENAI_BASE_URL=

# Optional. Overridden by --model when that flag is set.
OPENAI_MODEL=gpt-4o-mini
